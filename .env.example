# ==========================================
# Core Flask & Security Settings
# ==========================================
SECRET_KEY=geofence_biometric_super_secret_key_change_in_production_2026
SESSION_COOKIE_SECURE=False  # Set to True on Vercel / HTTPS production
SESSION_COOKIE_SAMESITE=Lax

# ==========================================
# Database Configuration (Supabase / Postgres / SQLite)
# ==========================================
# For Vercel Serverless Production, provide your Supabase/PostgreSQL Connection String:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For Local Development (SQLite):
DATABASE_PATH=database/geofence_bio.db

# ==========================================
# WebAuthn / Passkey Configuration
# ==========================================
# Local Development:
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FXEC BIOMETRIC Auth System
WEBAUTHN_ORIGIN=http://localhost:5000
# On Vercel:
# WEBAUTHN_RP_ID=your-project.vercel.app
# WEBAUTHN_ORIGIN=https://your-project.vercel.app

# ==========================================
# Default Geofence Settings
# ==========================================
DEFAULT_LOCATION_NAME=Authorized Campus Site
DEFAULT_LATITUDE=8.732309
DEFAULT_LONGITUDE=77.723764
DEFAULT_RADIUS_METERS=500.0
DEFAULT_MAX_GPS_ACCURACY=200.0

# ==========================================
# Admin Initial Seed Account
# ==========================================
ADMIN_USER_ID=admin
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@geofence.local
ADMIN_PHONE=+10000000000
ADMIN_PASSWORD=Admin@123456

